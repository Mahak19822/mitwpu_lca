   "source": [
    "#to check if a string contains only a-z,A-Z,0-9\n",
    "import re\n",
    "string=input(\"enter a string:\")\n",
    "if re.fullmatch(r\"[a-zA-Z0-9]+\",string):\n",
    "    print(\"string contains only a-z A-Z 0-9\")\n",
    "else:\n",
    "    print(\"string contains different characters\")"
   ]
  }
